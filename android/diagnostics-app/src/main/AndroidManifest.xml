<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 12+ requires this normal permission for SENSOR_DELAY_FASTEST. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <queries>
        <package android:name="com.google.ar.core" />
        <package android:name="com.google.android.gms" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_dialog_info"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".CalibrationCaptureActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".AdaptiveCalibrationActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".CampaignPlanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".SessionBindingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".CrossDeviceActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".RetentionActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".MeasurementActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".MeasurementFeedActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".RulerScaleActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".MetricValidationActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".SignatureActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".RedactionActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".IndependentTargetsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ConditionEvidenceActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".DeviceFarmCorpusActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ImuCalibrationActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>
